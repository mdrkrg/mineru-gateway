FROM docker.io/library/node:24-alpine AS build

ENV CI=true COREPACK_ENABLE_STRICT=0

RUN corepack enable && corepack prepare pnpm@11 --activate

WORKDIR /app

COPY frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml frontend/package.json ./
RUN pnpm install --frozen-lockfile

COPY frontend/ ./

# Empty means a root deployment. A non-root image is built for exactly one
# public mount point, for example FRONTEND_BASE_PATH=/mineru.
ARG FRONTEND_BASE_PATH=
RUN frontend_base="${FRONTEND_BASE_PATH%/}"; \
    VITE_APP_BASE_PATH="${frontend_base:-/}" \
    VITE_API_PREFIX="${frontend_base}/api" \
    pnpm build

FROM docker.io/library/caddy:2-alpine

COPY --from=build /app/dist /usr/share/caddy

EXPOSE 80
