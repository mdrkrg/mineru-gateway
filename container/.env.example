# Copy to container/.env

GATEWAY_UPSTREAM_URL=http://host.containers.internal:8002
POSTGRES_PASSWORD=replace-with-a-strong-password
GATEWAY_ADMIN_TOKEN=replace-with-a-strong-token

# Empty serves the UI at / and the API at /api. Use an absolute path without a
# trailing slash to build and serve both below that mount point.
FRONTEND_BASE_PATH=/mineru
FRONTEND_LISTEN=127.0.0.1:3000

# Public API URL used in generated task links and as the OAuth callback base.
GATEWAY_GATEWAY_URL=https://example.com/mineru/api

# Optional user authentication.
GATEWAY_USER_AUTH_ENABLED=false
GATEWAY_JWT_SECRET=replace-with-at-least-32-characters
GATEWAY_OPEN_REGISTRATION=false
# Browser destination after OAuth or email verification.
GATEWAY_OAUTH_FRONTEND_REDIRECT_URL=https://example.com/mineru/oauth/callback
