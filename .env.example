# mineru-gateway configuration (env prefix: GATEWAY_)
# Copy to .env and adjust. Values shown are the defaults unless noted.

# --- Core ---
# Upstream mineru-router / mineru-api base URL.
GATEWAY_UPSTREAM_URL=http://127.0.0.1:8002
# Database URL (SQLite default; swap to postgresql+asyncpg://... for PG).
GATEWAY_DATABASE_URL=sqlite+aiosqlite:///./gateway.db
# Token required to issue/manage API keys. MUST be set to a strong value.
GATEWAY_ADMIN_TOKEN=change-me
# Allow requests without an API key (pure passthrough, no task record).
GATEWAY_ALLOW_ANONYMOUS=false

# --- Gateway behavior ---
# Public base URL used to build status_url / result_url in responses.
GATEWAY_GATEWAY_URL=http://127.0.0.1:8000
# Max single-file upload size in bytes (500MB).
GATEWAY_MAX_UPLOAD_SIZE=524288000
# Per-key rate limit (requests/second).
GATEWAY_RATE_LIMIT_PER_KEY=10
# How long task records are retained (days).
GATEWAY_TASK_RETENTION_DAYS=90
# Auto-create tables on startup. Keep false in production; Alembic owns the
# schema. Set true only for tests / local one-shot setups.
GATEWAY_CREATE_TABLES=false

# --- Protection ---
# Global cap on in-flight (pending + processing + retry_pending) tasks.
# 0 disables the cap.
GATEWAY_MAX_CONCURRENT_TASKS=0
GATEWAY_LOG_LEVEL=INFO
# Emit structured JSON logs.
GATEWAY_JSON_LOGS=true

# --- Disaster recovery / background loops ---
GATEWAY_FILE_CACHE_DIR=/tmp/gateway-cache
# Enable background loops (status sync / retry / cleanup).
GATEWAY_ENABLE_BACKGROUND=true
GATEWAY_STATUS_SYNC_INTERVAL=5.0
GATEWAY_RETRY_INTERVAL=10.0
GATEWAY_CLEANUP_INTERVAL=3600.0
GATEWAY_MAX_RETRIES=3
GATEWAY_POLL_FAILURE_THRESHOLD=3

# --- CORS ---
# Allowed origins (comma-separated list or JSON array). Use "*" for all.
GATEWAY_CORS_ALLOW_ORIGINS=*
# Allowed HTTP methods.
GATEWAY_CORS_ALLOW_METHODS=*
# Allowed request headers.
GATEWAY_CORS_ALLOW_HEADERS=*
# Allow credentials (cookies, auth headers) in cross-origin requests.
GATEWAY_CORS_ALLOW_CREDENTIALS=false
# Preflight response cache duration in seconds.
GATEWAY_CORS_MAX_AGE=600

# --- Email verification (spec: email-verification.md) ---
# SMTP server hostname. Unset = email verification feature off: verify
# routes are not registered (404) and nothing is gated.
# GATEWAY_SMTP_HOST=smtp.example.com
# SMTP server port.
GATEWAY_SMTP_PORT=587
# SMTP auth username (usually the sender mailbox).
# GATEWAY_SMTP_USERNAME=sender@example.com
# SMTP auth password.
# GATEWAY_SMTP_PASSWORD=secret
# Sender address; falls back to GATEWAY_SMTP_USERNAME when unset. When
# GATEWAY_SMTP_HOST is set, one of the two is required or startup is refused.
# GATEWAY_SMTP_FROM=sender@example.com
# Sender display name.
GATEWAY_SMTP_FROM_NAME=mineru-gateway
# Upgrade the connection with STARTTLS (mutually exclusive with SSL_TLS).
GATEWAY_SMTP_STARTTLS=true
# Use a direct SSL/TLS connection (mutually exclusive with STARTTLS).
GATEWAY_SMTP_SSL_TLS=false
# SMTP connect/send timeout in seconds.
GATEWAY_SMTP_TIMEOUT=10
# Verification token lifetime in seconds (default 1 hour).
GATEWAY_VERIFY_EMAIL_TOKEN_LIFETIME_SECONDS=3600
# Base URL for the verification link in emails; falls back to
# GATEWAY_URL when unset.
GATEWAY_VERIFY_EMAIL_BASE_URL=
